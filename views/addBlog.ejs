<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <title>BlogIt — Share</title>
  <style>
    .write-page {
      display: grid;
      grid-template-columns: 1fr min(760px, 100%) 1fr;
      padding: clamp(2rem, 5vw, 4rem) 0 6rem;
    }
    .write-page > * { grid-column: 2; padding: 0 1rem; }

    .write-eyebrow {
      font-family: var(--mono);
      font-size: 0.72rem; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--accent);
      margin-bottom: 0.75rem;
    }
    .write-heading {
      font-family: var(--serif);
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 900; letter-spacing: -0.025em;
      margin-bottom: 0.5rem;
    }
    .write-sub { color: var(--muted); font-size: 0.9rem; margin-bottom: 2.5rem; }

    .write-form { display: flex; flex-direction: column; gap: 1.5rem; }

    /* Big title input */
    .title-input {
      width: 100%;
      background: transparent;
      border: none;
      border-bottom: 2px solid var(--border);
      border-radius: 0;
      color: var(--text);
      font-family: var(--serif);
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 700;
      padding: 0.5rem 0 0.85rem;
      outline: none;
      transition: var(--trans);
      letter-spacing: -0.02em;
    }
    .title-input:focus { border-bottom-color: var(--accent); }
    .title-input::placeholder { color: #3e3c46; }

    /* Body textarea */
    .body-textarea {
      width: 100%;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-family: var(--sans);
      font-size: 1rem;
      line-height: 1.8;
      padding: 1.25rem;
      outline: none;
      min-height: 320px;
      resize: vertical;
      transition: var(--trans);
    }
    .body-textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(232,201,126,0.08); }
    .body-textarea::placeholder { color: #3e3c46; }

    /* Image upload zone */
    .upload-zone {
      border: 2px dashed var(--border);
      border-radius: 8px;
      padding: 2rem;
      text-align: center;
      cursor: pointer;
      transition: var(--trans);
      position: relative;
    }
    .upload-zone:hover { border-color: var(--accent); background: rgba(232,201,126,0.03); }
    .upload-zone input[type="file"] {
      position: absolute; inset: 0;
      opacity: 0; cursor: pointer; width: 100%; height: 100%;
    }
    .upload-icon { font-size: 2rem; margin-bottom: 0.5rem; color: var(--muted); }
    .upload-label { font-size: 0.88rem; color: var(--muted); }
    .upload-label strong { color: var(--text); }

    /* Preview */
    #img-preview {
      display: none;
      width: 100%; border-radius: 8px;
      border: 1px solid var(--border);
      max-height: 280px; object-fit: cover;
    }

    .form-actions {
      display: flex; align-items: center; gap: 1rem;
      padding-top: 0.5rem;
    }
    .char-count { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); margin-left: auto; }
  </style>
</head>
<body>
  <%- include("./partials/nav") %>

  <div class="write-page page-enter">
    <div>
      <p class="write-eyebrow">New post</p>
      <h1 class="write-heading">Write something.</h1>
      <p class="write-sub">Your words. Your story. Make it count.</p>

      <form action="/blog" method="post" enctype="multipart/form-data" class="write-form">

        <div>
          <input
            type="text"
            class="title-input"
            name="title"
            placeholder="Your headline here…"
            value="<%= typeof title !== 'undefined' ? title : '' %>"
            required
          >
        </div>

        <div class="form-group" style="margin:0">
          <label class="form-label">Body</label>
          <textarea
            class="body-textarea"
            name="body"
            id="bodyText"
            placeholder="Tell your story…"
            required
          ><%= typeof body !== 'undefined' ? body : '' %></textarea>
        </div>

        <div>
          <label class="form-label">Cover Image</label>
          <div class="upload-zone" id="dropZone">
            <input type="file" name="coverImage" id="coverImage" accept="image/*">
            <div class="upload-icon">⬆</div>
            <p class="upload-label"><strong>Click to upload</strong> or drag & drop<br>PNG, JPG, WEBP — max 5 MB</p>
          </div>
          <img id="img-preview" alt="Preview">
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Publish →</button>
          <a href="/" class="btn btn-ghost">Discard</a>
          <span class="char-count" id="charCount">0 words</span>
        </div>

      </form>
    </div>
  </div>

  <%- include("./partials/scripts") %>
  <script>
    // Word count
    const body = document.getElementById('bodyText');
    const count = document.getElementById('charCount');
    body?.addEventListener('input', () => {
      const words = body.value.trim().split(/\s+/).filter(Boolean).length;
      count.textContent = words + ' word' + (words !== 1 ? 's' : '');
    });

    // Image preview
    const fileInput = document.getElementById('coverImage');
    const preview = document.getElementById('img-preview');
    const zone = document.getElementById('dropZone');
    fileInput?.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const url = URL.createObjectURL(file);
      preview.src = url;
      preview.style.display = 'block';
      zone.style.display = 'none';
    });
  </script>
</body>
</html>
