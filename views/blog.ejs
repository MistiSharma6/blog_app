<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <title><%= blog.title %> — Ink</title>
  <style>
    /* Cover */
    .blog-cover {
      width: 100%;
      max-height: 520px;
      object-fit: cover;
      display: block;
    }
    .blog-cover-wrap {
      overflow: hidden;
      border-bottom: 1px solid var(--border);
      max-height: 520px;
    }

    /* Article layout */
    .article-wrap {
      display: grid;
      grid-template-columns: 1fr min(680px, 100%) 1fr;
      padding: clamp(2rem, 5vw, 4rem) 0;
      gap: 0 2rem;
    }
    .article-wrap > * { grid-column: 2; }

    .article-label {
      font-family: var(--mono);
      font-size: 0.72rem; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--accent);
      margin-bottom: 1rem;
    }
    .article-title {
      font-family: var(--serif);
      font-size: clamp(2rem, 5vw, 3.4rem);
      font-weight: 900;
      line-height: 1.12;
      letter-spacing: -0.025em;
      color: var(--text);
      margin-bottom: 1.75rem;
    }

    /* Author chip */
    .author-chip {
      display: flex; align-items: center; gap: 0.85rem;
      padding: 0.85rem 1.1rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 2.5rem;
    }
    .author-avatar {
      width: 44px; height: 44px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--border);
      flex-shrink: 0;
    }
    .author-name { font-weight: 500; font-size: 0.95rem; }
    .author-meta { font-size: 0.78rem; color: var(--muted); }

    /* Body text */
    .article-body {
      font-size: 1.08rem;
      line-height: 1.85;
      color: #d0cec9;
      white-space: pre-wrap;
      font-family: var(--sans);
      margin-bottom: 3rem;
    }

    hr.article-rule {
      border: none;
      border-top: 1px solid var(--border);
      margin: 2.5rem 0;
    }

    /* Comments */
    .comments-header {
      font-family: var(--serif);
      font-size: 1.7rem;
      font-weight: 700;
      margin-bottom: 1.75rem;
      letter-spacing: -0.02em;
    }
    .comments-header span {
      font-family: var(--mono);
      font-size: 0.9rem;
      color: var(--accent);
      font-weight: 400;
      margin-left: 0.5rem;
      vertical-align: middle;
    }

    /* Comment form */
    .comment-form {
      display: flex; gap: 0.75rem; align-items: flex-start;
      margin-bottom: 2.5rem;
    }
    .comment-form input {
      flex: 1;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      color: var(--text);
      font-family: var(--sans); font-size: 0.95rem;
      padding: 0.72rem 1rem;
      outline: none;
      transition: var(--trans);
    }
    .comment-form input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(232,201,126,0.1); }
    .comment-form input::placeholder { color: #55535e; }

    /* Not logged in alert */
    .auth-nudge {
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem;
      background: rgba(232,201,126,0.06);
      border: 1px solid rgba(232,201,126,0.2);
      border-radius: var(--radius);
      padding: 1rem 1.2rem;
      margin-bottom: 2rem;
      font-size: 0.9rem;
      color: var(--muted);
    }

    /* Comment items */
    .comment-list { display: flex; flex-direction: column; gap: 1.25rem; }
    .comment-item {
      display: flex; gap: 0.85rem; align-items: flex-start;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--border);
    }
    .comment-item:last-child { border-bottom: none; }
    .comment-avatar {
      width: 36px; height: 36px;
      border-radius: 50%; object-fit: cover;
      border: 1px solid var(--border); flex-shrink: 0;
    }
    .comment-meta { font-size: 0.82rem; color: var(--muted); margin-bottom: 0.3rem; }
    .comment-meta strong { color: var(--text); font-weight: 500; }
    .comment-text { font-size: 0.95rem; line-height: 1.6; color: #c8c5bf; }

    .no-comments { color: var(--muted); font-size: 0.9rem; font-style: italic; }
  </style>
</head>
<body>
  <%- include("./partials/nav") %>

  <% if (blog.coverImageURL) { %>
    <div class="blog-cover-wrap">
      <img src="<%= blog.coverImageURL %>" alt="<%= blog.title %>" class="blog-cover">
    </div>
  <% } %>

  <div class="article-wrap page-enter">

    <p class="article-label">Story</p>

    <h1 class="article-title"><%= blog.title %></h1>

    <div class="author-chip">
      <img src="<%= blog.createdBy.profileImageURL %>" alt="<%= blog.createdBy.fullName %>" class="author-avatar">
      <div>
        <div class="author-name"><%= blog.createdBy.fullName %></div>
        <div class="author-meta">Author</div>
      </div>
    </div>

    <div class="article-body"><%= blog.body %></div>

    <hr class="article-rule">

    <!-- Comments -->
    <h2 class="comments-header">
      Comments <span><%= comments.length %></span>
    </h2>

    <% if (locals.user) { %>
      <form action="/blog/comment/<%= blog._id %>" method="post" class="comment-form">
        <input type="text" name="content" placeholder="Share your thoughts…" required>
        <button type="submit" class="btn btn-primary">Post</button>
      </form>
    <% } else { %>
      <div class="auth-nudge">
        <span>Sign in to join the conversation.</span>
        <a href="/user/signin" class="btn btn-ghost">Sign in</a>
      </div>
    <% } %>

    <div class="comment-list">
      <% if (comments.length === 0) { %>
        <p class="no-comments">No comments yet. Be the first.</p>
      <% } %>
      <% comments.forEach(comment => { %>
        <div class="comment-item">
          <img src="<%= comment.createdBy.profileImageURL %>" alt="" class="comment-avatar">
          <div>
            <p class="comment-meta"><strong><%= comment.createdBy.fullName %></strong></p>
            <p class="comment-text"><%= comment.content %></p>
          </div>
        </div>
      <% }) %>
    </div>

  </div>

  <%- include("./partials/scripts") %>
</body>
</html>
